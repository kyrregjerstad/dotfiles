{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(git log:*)",
      "Bash(git cat:*)",
      "Bash(npm run lint:errors)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__context7__query-docs",
      "WebSearch",
      "WebFetch",
      "Skill(commit)",
      "Skill(PR-DESCRIPTION)",
      "Skill(linear-cli)",
      "Skill(frontend-design)",
      "Skill(effect)",
      "Skill(security-audit)",
      "Read(~/.claude/skills/effect/*)",
      "Read(~/.claude/skills/security-audit/*)",
      "Read(~/.zshrc)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/Projects/cc-module/hooks/stop.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/Projects/cc-module/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/k/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/Projects/cc-module/hooks/session-end.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/Projects/cc-module/hooks/user-prompt.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/Projects/cc-module/hooks/pre-tool.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/Projects/cc-module/hooks/post-tool.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); usage=$(echo \"$input\" | jq '.context_window.current_usage'); wt=$(basename \"$(git rev-parse --show-toplevel 2>/dev/null)\" 2>/dev/null); branch=$(git symbolic-ref --short HEAD 2>/dev/null); BLUE='\\033[38;2;137;180;250m'; GREEN='\\033[38;2;166;227;161m'; RED='\\033[38;2;243;139;168m'; DIM='\\033[2m'; RESET='\\033[0m'; case \"$wt\" in bitfocus-buttons-1) COLOR=\"$BLUE\";; bitfocus-buttons-2) COLOR=\"$GREEN\";; bitfocus-buttons-3) COLOR=\"$RED\";; *) COLOR=\"\";; esac; label=\"\"; if [ -n \"$wt\" ] && [ -n \"$COLOR\" ]; then label=\"$(printf '%b%s%b' \"$COLOR\" \"$wt\" \"$RESET\")\"; elif [ -n \"$wt\" ]; then label=\"$wt\"; fi; if [ -n \"$branch\" ] && [ -n \"$label\" ]; then label=\"$(printf '%s %b%s%b' \"$label\" \"$DIM\" \"$branch\" \"$RESET\")\"; elif [ -n \"$branch\" ]; then label=\"$(printf '%b%s%b' \"$DIM\" \"$branch\" \"$RESET\")\"; fi; if [ \"$usage\" != \"null\" ]; then current=$(echo \"$usage\" | jq '.input_tokens + .cache_creation_input_tokens + .cache_read_input_tokens'); size=$(echo \"$input\" | jq '.context_window.context_window_size'); pct=$((current * 100 / size)); if [ -n \"$label\" ]; then printf \"[%d%%] %b\" \"$pct\" \"$label\"; else printf \"[%d%%]\" \"$pct\"; fi; else if [ -n \"$label\" ]; then printf \"%b\" \"$label\"; fi; fi"
  },
  "enabledPlugins": {
    "linear-cli@linear-cli": true,
    "example-skills@anthropic-agent-skills": false,
    "gopls-lsp@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "cc-zjstatus@claude-code-zellij-status": false,
    "context-mode@context-mode": true,
    "vercel@claude-plugins-official": true,
    "vercel-plugin@vercel": true
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "claude-code-zellij-status": {
      "source": {
        "source": "git",
        "url": "https://github.com/thoo/claude-code-zellij-status.git"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
